{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/camping",
      "destination": "/camping/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/abuse",
      "destination": "/abuse/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:slug([A-Za-z0-9][A-Za-z0-9_-]{0,63})\\+",
      "destination": "/api/go?slug=:slug&preview=1"
    },
    {
      "source": "/:slug([A-Za-z0-9][A-Za-z0-9_-]{0,63})",
      "destination": "/api/go?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
